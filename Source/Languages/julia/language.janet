{:name "julia"
 :extensions [".jl"]
 :injection-aliases ["jl"]
 :line-comment "#"
 :lsp-root-markers ["Project.toml" "JuliaProject.toml"]
 :signature-template "function __ned_sig({})\nend"
 :import-resolution {:extensions ["jl"]}
 :not-applicable {:style "no canonical formatter or official style rule for the braces and blank lines ned's rules cover"}
}
