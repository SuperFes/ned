# The default mode: no grammar, no capabilities, no comment syntax.

{:name "fundamental"
 :grammar :none
 :not-applicable {:highlights "plain text: no grammar"
                  :indents    "plain text: no grammar"
                  :locals     "plain text: no grammar"
                  :tags       "plain text: no grammar"
                  :injections "plain text: no grammar"
                  :imports    "plain text: no grammar"
                  :tests      "plain text: no grammar"
                  :signatures "plain text: no grammar"
                  :format     "plain text: no grammar"
                  :comments   "plain text: no grammar"
                  :lsp-root   "plain text: no grammar"}
}
