#; Symbol-kind query, ned-authored: the document title and the section
#; titles (one node type per level) are the outline; a title's text is
#; its line.
(document_title
  (line) @name) @definition.module
(section_block
  (title1
    (line) @name)) @definition.module
(section_block
  (title2
    (line) @name)) @definition.module
(section_block
  (title3
    (line) @name)) @definition.module
(section_block
  (title4
    (line) @name)) @definition.module
(section_block
  (title5
    (line) @name)) @definition.module
